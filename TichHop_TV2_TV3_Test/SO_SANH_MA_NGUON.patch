+        mode = os.environ["TV3_FAKE_MODE"]
+        replies = {
+            "wrong_id": {"ack": True, "ma_gd": payload["ma_gd"] + "-WRONG"},
+            "array": [{"ack": True, "ma_gd": payload["ma_gd"]}],
